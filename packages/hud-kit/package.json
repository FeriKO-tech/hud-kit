{
  "name": "@feriko/hud-kit",
  "version": "0.1.0",
  "description": "Gaming HUD components for React — health bars, mana bars, inventory grids, damage numbers, and more",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "framer-motion": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^11.15.0",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "keywords": [
    "react",
    "hud",
    "gamedev",
    "gaming",
    "ui",
    "health-bar",
    "mana-bar",
    "inventory",
    "game-ui",
    "components",
    "typescript"
  ],
  "author": "FeriKO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feriko/hud-kit"
  },
  "homepage": "https://hud-kit.vercel.app"
}
